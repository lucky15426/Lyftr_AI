# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit .env.

# --- LLM key pool (comma separated, tried in order: key_1, key_2, ...) ---
# Use at least two keys so failover is meaningful. Gemini keys: https://aistudio.google.com/apikey
LLM_API_KEYS=your-gemini-api-key-1,your-gemini-api-key-2

# Any model supported by LiteLLM (https://docs.litellm.ai/docs/providers).
# If this model is retired by Google, switch to a current one, e.g. gemini/gemini-3.5-flash-lite
LLM_MODEL=gemini/gemini-3.1-flash-lite

# --- Storage ---
# Four slashes = absolute path. Inside Docker this lives on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# --- HTTP ---
# Comma separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# --- Failover test hook (X-Simulate-Failure header). Set to false in real production. ---
ENABLE_FAILURE_SIMULATION=true

# --- Optional tuning ---
CACHE_TTL_SECONDS=86400
LLM_TIMEOUT_SECONDS=30

# --- Frontend (read by docker compose at build time) ---
# URL the browser uses to reach the backend.
VITE_API_URL=http://localhost:8000
